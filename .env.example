# Copy this file to `.env` and fill in your own values.
# NEVER commit the real .env file — it is listed in .gitignore.

# Required: your OpenAI API key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-your-key-here

# Optional: model used for all generations (default: gpt-5.4-mini)
OPENAI_MODEL=gpt-5.4-mini

# Optional: sampling temperature. Leave blank for reasoning models that do not
# accept it — StudyMate automatically drops unsupported parameters and retries.
OPENAI_TEMPERATURE=

# Optional: reasoning effort for reasoning models (none | low | medium | high).
# Ignored automatically if the selected model does not support it.
OPENAI_REASONING_EFFORT=low

# Optional: maximum output tokens per prompt task (includes reasoning tokens)
OPENAI_MAX_OUTPUT_TOKENS=4000
